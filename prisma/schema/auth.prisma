model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  passwordHash  String
  emailVerified Boolean @default(false)
  role          Role    @default(BUYER)
  image         String?

  vendor Vendor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}
