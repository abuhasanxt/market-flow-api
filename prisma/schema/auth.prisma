model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  passwordHash  String
  emailVerified Boolean @default(false)
  role          Role    @default(BUYER)
  image         String?
  
  cart          Cart?
  vendor     Vendor?
  categories Category[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}
